{
  "expo": {
    "name": "Atos2",
    "slug": "atos2",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "atos2",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0e27"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.atos2.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "O app precisa da câmera para escanear documentos e QR codes.",
        "NSMicrophoneUsageDescription": "O app precisa do microfone para gravação de áudio e chamadas.",
        "NSLocationWhenInUseUsageDescription": "O app precisa da localização para conectar ao terminal de pagamento.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "O app precisa da localização em segundo plano para o terminal de pagamento.",
        "NSBluetoothAlwaysUsageDescription": "O app usa Bluetooth para conectar ao leitor de cartão.",
        "NSBluetoothPeripheralUsageDescription": "O app usa Bluetooth para conectar ao leitor de cartão.",
        "NFCReaderUsageDescription": "O app usa NFC para leitura de cartões e documentos.",
        "NSFaceIDUsageDescription": "Use o Face ID para autenticação rápida e segura.",
        "NSPhotoLibraryUsageDescription": "O app acessa a galeria para seleção de imagens e documentos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0e27",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.atos2.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.NFC",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 26,
            "packagingOptions": {
              "pickFirst": [
                "META-INF/NOTICE.md",
                "META-INF/LICENSE.md",
                "org/bouncycastle/pqc/crypto/picnic/lowmcL5.bin.properties"
              ],
              "exclude": [
                "org/bouncycastle/*"
              ]
            }
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.atos2.app",
          "enableGooglePay": true
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "@stripe/stripe-terminal-react-native",
        {
          "android": {
            "permission": "Always"
          },
          "ios": {
            "locationWhenInUseUsageDescription": "O app precisa da localização para conectar ao terminal de pagamento.",
            "bluetoothAlwaysUsageDescription": "O app usa Bluetooth para conectar ao leitor de cartão."
          }
        }
      ],
      "expo-font",
      "expo-asset"
    ],
    "updates": {
      "url": "https://u.expo.dev/a9bd4606-9485-45af-b237-f7dff175bfc6",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "apiUrl": "http://142.93.59.54:3001/api",
      "router": {},
      "eas": {
        "projectId": "a9bd4606-9485-45af-b237-f7dff175bfc6"
      }
    },
    "owner": "camposmourao"
  }
}